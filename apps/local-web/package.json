{
  "name": "@pgard/local-web",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/server/create-server.ts",
      "types": "./dist/server/create-server.d.ts",
      "default": "./dist/server/create-server.js"
    },
    "./launcher": {
      "default": "./dist/server/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build:client": "node ../../node_modules/typescript/bin/tsc -p tsconfig.client.json && vite build --config vite.config.ts",
    "preview:mock": "node dev/mock-server.mjs"
  },
  "dependencies": {
    "@pgard/findings": "0.1.0",
    "@pgard/git-history": "0.1.0",
    "@pgard/http-local": "0.1.0",
    "@pgard/policy": "0.1.0",
    "@pgard/report": "0.1.0",
    "@pgard/result-store": "0.1.0",
    "@pgard/scan-core": "0.1.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vite": "8.3.5"
  }
}
