{
  "name": "pgard-workspace",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "node ./node_modules/typescript/bin/tsc -b && npm run build:client -w @pgard/local-web",
    "typecheck": "node ./node_modules/typescript/bin/tsc -b && npm run typecheck:tests",
    "typecheck:tests": "node ./node_modules/typescript/bin/tsc -p tsconfig.test.json && node ./node_modules/typescript/bin/tsc -p apps/local-web/tsconfig.client.test.json",
    "test": "vitest run --passWithNoTests",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run format:check && npm test",
    "pack:pgard": "npm run build && node scripts/pack-pgard.mjs",
    "smoke:pack": "node scripts/smoke-pack.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "0.28.2",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
